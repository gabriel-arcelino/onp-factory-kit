{
  "version": "0.1",
  "profile": "{{PROFILE}}",
  "adapter": {
    "path": ".onp-factory/scripts"
  },
  "onp": {
    "enginePathCandidates": [
      ".onp-factory/onp-engine/scripts/onp-spec.mjs",
      ".claude/skills/onp-spec-driven/scripts/onp-spec.mjs",
      ".kilo/skills/onp-spec-driven/scripts/onp-spec.mjs"
    ]
  },
  "database": {
    "provider": "supabase",
    "projectId": null,
    "container": null,
    "resetCommand": "npx supabase db reset",
    "allowProductionReset": false
  },
  "commands": {
    "featureVerify": "node .onp-factory/scripts/feature-verify.cjs <feature>",
    "globalRegression": "node .onp-factory/scripts/combined-verify.cjs",
    "audit": "node <onp-engine> audit --ci",
    "build": "npm run build",
    "lint": "npm run lint"
  },
  "policy": {
    "featureVerifyIsNotGlobalRegression": true,
    "resetLocalDbBeforePgTapFeatureVerify": true,
    "productionDbResetAllowed": false
  }
}
